            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Proyecto de prueba desde Postman\",\n  \"tipo\": \"proyecto\",\n  \"categoria\": \"Proyectos\",\n  \"anio\": 2024,\n  \"descripcion\": \"Contenido creado para probar el CRUD.\"\n}"
            }
