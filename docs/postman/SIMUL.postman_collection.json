{
  "info": {
    "_postman_id": "b7f5c1a2-6d4e-4c1a-9f0e-1a2b3c4d5e6f",
    "name": "SIMUL · Museo Digital — API",
    "description": "Colección de pruebas manuales del backend FastAPI de SIMUL.\n\nPasos:\n1. Levanta el proyecto con `docker compose up --build` (o uvicorn local).\n2. Ejecuta **Auth → Login** (guarda el token automáticamente).\n3. Prueba el resto de carpetas.\n\nLa variable `baseUrl` apunta a http://localhost:5000 por defecto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "contenidoId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('sin password en la respuesta', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('password_hash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/museo/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "museo", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Estudiante Demo\",\n  \"correo\": \"estudiante.demo@unilibre.edu.co\",\n  \"password\": \"clave12345\"\n}"
            }
          }
        },
        {
          "name": "Login (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('devuelve access_token', () => pm.expect(cuerpo.data.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', cuerpo.data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/museo/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "museo", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"l.jimenez@unilibre.edu.co\",\n  \"password\": \"1234\"\n}"
            }
          }
        },
        {
          "name": "Perfil (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/museo/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "museo", "auth", "me"] }
          }
        },
        {
          "name": "Login inválido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/museo/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "museo", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"l.jimenez@unilibre.edu.co\",\n  \"password\": \"incorrecta\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Contenido",
      "item": [
        {
          "name": "Listar contenido",
          "request": {
            "method": "GET",
            "header": [],
