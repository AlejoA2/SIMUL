            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/museo/contenido/{{contenidoId}}", "host": ["{{baseUrl}}"], "path": ["api", "museo", "contenido", "{{contenidoId}}"] }
          }
        }
      ]
    },
