# ============================================================
# SIMUL · variables de entorno (ejemplo)
#
# Copia este archivo como ".env" y ajusta los valores si hace
# falta. La app lo carga automáticamente al arrancar (python-dotenv).
# docker-compose.yml inyecta las suyas en el contenedor, así que
# dentro de Docker este archivo no es necesario.
# ============================================================

# Conexión a MySQL (el "db" del compose expone el 3307).
# Sin esta variable la app usa SQLite como respaldo local.
DATABASE_URL=mysql+pymysql://simul_user:simul_password@127.0.0.1:3307/simul_db

# Clave para firmar los JWT (mínimo 32 caracteres).
JWT_SECRET_KEY=simul-dev-secret-key-cambiar-en-produccion-2026

# Duración del access token en segundos (1 hora).
JWT_ACCESS_TOKEN_EXPIRES=3600
